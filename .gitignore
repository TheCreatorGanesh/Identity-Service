# A streamlined .gitignore for modern .NET projects
# including temporary files, build results, and
# files generated by popular .NET tools.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.DotSettings.user
*.vspscc
*.vssscc

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/

# .NET and package artifacts
project.lock.json
project.fragment.lock.json
*.nupkg
*.snupkg
packages/

# ASP.NET Core
ScaffoldingReadMe.txt
wwwroot/dist/

# Environment and local configuration
.env
.env.*
!.env.example
appsettings.*.json
!appsettings.json

# Test results and coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
Coverage/
coverage/
CodeCoverage/
*.trx
*.coverage
*.coveragexml

# MSBuild
*.binlog

# macOS
.DS_Store
.AppleDouble
.LSOverride
*.swp

# General
~$*
*~
*.tmp
*.temp
*.log

# AI temp artifacts
.temp/*
!.temp/README.md
